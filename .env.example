# Copy to .env.local and fill in. Without MODEL_API_KEY the app runs a scripted
# game master (mock mode), so you can build the UI without spending credits.

# --- Meta Model API (https://dev.meta.ai) ---
MODEL_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1

# Game master: writes the plan, reads every photo, issues quests.
# GM_MODEL=muse-wonder-1.0
# minimal | low | medium | high | xhigh | max. Higher is slower and costs more.
# GM_REASONING_EFFORT=minimal

# Story cards: when a photo moves the story, Muse Image paints it into a card ($0.01/image).
# QUEST_CARDS=on
# IMAGE_MODEL=muse-image-1.0
# low | high. Leave empty for the API default (high).
# IMAGE_REASONING_STRENGTH=

# Grounding: SAM 3.1 outlines in_view quest targets on the photo.
# SAM_GROUNDING=on
# SAM_MODEL=sam-3.1

# --- Daily limit ---
# Paid calls per UTC day, all players together. Each story start, photo, walk end and
# painted card counts once. Past the limit the app asks people to come back later.
# 0 turns it off.
# DAILY_CALL_LIMIT=200
# Paid calls per UTC day for one player, counted by IP address. 0 turns it off.
# PLAYER_DAILY_CALL_LIMIT=60

# --- Storage ---
# Leave the Appwrite values empty to keep data in local files under DATA_DIR (dev only).
# Fill them in, then run `npm run setup:appwrite` once.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# APPWRITE_DATABASE_ID=questory
# APPWRITE_BUCKET_ID=media
# STORAGE=appwrite | file
# DATA_DIR=.data

# Force mock mode even with a key set:
# MOCK=1
